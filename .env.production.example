# Plantilla para el servidor de producción. No copies secretos a este archivo.
APP_NAME=CROWFONDING
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.example

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Configura aquí un transporte de correo antes de habilitar la verificación
# de cuentas en producción. No guardes contraseñas en el repositorio.
